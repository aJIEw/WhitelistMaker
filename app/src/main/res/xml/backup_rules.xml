<?xml version="1.0" encoding="utf-8"?><!--
   Android 11 及以下的自动备份规则。白名单文件和安装记录只保存在本机，
   全部 domain 排除，避免数据进入云备份。
-->
<full-backup-content>
    <exclude
        domain="root"
        path="." />
    <exclude
        domain="file"
        path="." />
    <exclude
        domain="database"
        path="." />
    <exclude
        domain="sharedpref"
        path="." />
    <exclude
        domain="external"
        path="." />
</full-backup-content>
